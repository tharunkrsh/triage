<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>triage simulation report</title>
<style>
:root {
  --bg: #ffffff; --fg: #1f2328; --muted: #59636e; --border: #d1d9e0;
  --panel: #f6f8fa; --accent: #0969da;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #0d1117; --fg: #e6edf3; --muted: #9198a1; --border: #3d444d;
    --panel: #151b23; --accent: #4493f8;
  }
}
* { box-sizing: border-box; }
body {
  margin: 0; padding: 24px 16px 48px; background: var(--bg); color: var(--fg);
  font: 15px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
}
main { max-width: 1080px; margin: 0 auto; }
h1 { font-size: 1.6rem; margin: 0 0 4px; }
h2 { font-size: 1.25rem; margin: 32px 0 8px; border-bottom: 1px solid var(--border); padding-bottom: 4px; }
h3 { font-size: 1.05rem; margin: 20px 0 6px; }
.meta, .note { color: var(--muted); font-size: 0.9rem; margin: 0 0 8px; }
.tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; }
.tile { background: var(--panel); border: 1px solid var(--border); border-radius: 8px; padding: 12px 14px; }
.tile .label { color: var(--muted); font-size: 0.85rem; }
.tile .value { font-size: 1.2rem; font-weight: 600; font-variant-numeric: tabular-nums; }
.scroll { overflow-x: auto; }
table { border-collapse: collapse; width: 100%; margin: 6px 0 12px; font-size: 0.9rem; }
th, td { border-bottom: 1px solid var(--border); padding: 6px 10px; text-align: left; vertical-align: top; }
th { background: var(--panel); font-weight: 600; }
td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
code { font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: 0.85em; white-space: pre-wrap; word-break: break-word; }
td.model, td.ci { white-space: nowrap; }
svg { display: block; width: 100%; height: auto; }
svg.overall { max-width: 760px; }
svg text { fill: var(--fg); font-size: 12px; }
svg text.tick, svg text.legend { fill: var(--muted); }
svg text.label { paint-order: stroke; stroke: var(--bg); stroke-width: 3px; stroke-linejoin: round; }
svg .axis { stroke: var(--muted); stroke-opacity: 0.6; }
svg .grid { stroke: var(--border); stroke-opacity: 0.6; }
svg .whisker { stroke: var(--muted); stroke-width: 1.5; stroke-opacity: 0.7; }
svg .whisker.low-n { stroke-opacity: 0.5; }
svg .stem.low-n { stroke-dasharray: 4 3; }
svg .step { fill: none; stroke: var(--accent); stroke-width: 1.5; stroke-opacity: 0.55; }
svg circle { fill: var(--bg); stroke: var(--accent); stroke-width: 2; }
svg circle.frontier { fill: var(--accent); }
.slices { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: 12px; margin-top: 8px; }
.card { background: var(--panel); border: 1px solid var(--border); border-radius: 8px; padding: 10px 12px; }
.card h3 { margin: 0 0 4px; font-size: 0.95rem; }
.card svg text.label { stroke: var(--panel); }
.card svg circle.dominated { fill: var(--panel); }
summary { cursor: pointer; color: var(--muted); font-size: 0.9rem; margin-top: 12px; }
</style>
</head>
<body>
<main>
<h1>triage simulation report</h1>
<p class="meta">{% if r.source %}Source: <code>{{ r.source }}</code> · {% endif %}Generated {{ generated }}</p>

<h2>Summary</h2>
<div class="tiles">
  <div class="tile"><div class="label">Simulation spend (Batch API, including judge)</div><div class="value">{{ r.total_sim_cost | usd }}</div></div>
  <div class="tile"><div class="label">Judge model</div><div class="value">{{ r.judge_model or "not used" }}</div></div>
  <div class="tile"><div class="label">Judge vs deterministic agreement</div><div class="value">{{ r.agreement | ci }}</div></div>
</div>

<h2>Models overall</h2>
<p class="note">Pass rates show 95% Wilson intervals over graded tasks. Errored, expired and canceled replays are counted separately. Costs are projected at standard (non-batch) rates.</p>
<div class="scroll"><table>
<thead><tr><th>Model</th><th>Pass rate</th><th class="num">Passes</th><th class="num">Errored</th><th class="num">Cost per task</th><th class="num">Cost per success</th><th>Pareto frontier</th></tr></thead>
<tbody>
{% for s in r.overall %}
<tr><td class="model">{{ s.model }}</td><td class="ci">{{ s.pass_rate | ci }}</td><td class="num">{{ s.passes | tokens }}</td><td class="num">{{ s.errored | tokens }}</td><td class="num">{{ s.projected_cost_per_task | usd_fine }}</td><td class="num">{{ s.cost_per_success | usd_fine }}</td><td>{{ "yes" if s.on_frontier else "no" }}</td></tr>
{% endfor %}
</tbody>
</table></div>

{% macro whisker(x, y_high, y_low, low_n) %}
  <g class="whisker{{ ' low-n' if low_n }}">
    <line class="stem{{ ' low-n' if low_n }}" x1="{{ x }}" y1="{{ y_high }}" x2="{{ x }}" y2="{{ y_low }}"/>
    <line x1="{{ x - marks.cap }}" y1="{{ y_high }}" x2="{{ x + marks.cap }}" y2="{{ y_high }}"/>
    <line x1="{{ x - marks.cap }}" y1="{{ y_low }}" x2="{{ x + marks.cap }}" y2="{{ y_low }}"/>
  </g>
{% endmacro %}
{% macro plot(chart, kind) %}
{% set f = chart.frame %}
<svg class="{{ kind }}" viewBox="0 0 {{ f.width }} {{ f.height }}" role="img" aria-label="Cost against pass rate for {{ chart.title }}">
{% if kind == "overall" %}
  <circle class="frontier" cx="{{ f.left + 6 }}" cy="14" r="5"/>
  <text class="legend" x="{{ f.left + 18 }}" y="18">Frontier</text>
  <circle class="dominated" cx="{{ f.left + 100 }}" cy="14" r="5"/>
  <text class="legend" x="{{ f.left + 112 }}" y="18">Dominated</text>
  <path class="step" d="M {{ f.left + 208 }} 14 H {{ f.left + 232 }}"/>
  <text class="legend" x="{{ f.left + 240 }}" y="18">Frontier step (at CI lower bound)</text>
{{ whisker(f.left + 6, 27, 41, false) }}
  <text class="legend" x="{{ f.left + 18 }}" y="38">95% Wilson CI</text>
{{ whisker(f.left + 130, 27, 41, true) }}
  <text class="legend" x="{{ f.left + 142 }}" y="38">Dashed: n &lt; {{ marks.low_n }}</text>
{% endif %}
{% for line in chart.grid %}
  <line class="grid" data-percent="{{ line.percent }}" x1="{{ f.left }}" y1="{{ line.y }}" x2="{{ f.right }}" y2="{{ line.y }}"/>
  <text class="tick" x="{{ f.left - 8 }}" y="{{ line.y + 4 }}" text-anchor="end">{{ line.percent }}%</text>
{% endfor %}
  <line class="axis" x1="{{ f.left }}" y1="{{ f.top }}" x2="{{ f.left }}" y2="{{ f.bottom }}"/>
  <line class="axis" x1="{{ f.left }}" y1="{{ f.bottom }}" x2="{{ f.right }}" y2="{{ f.bottom }}"/>
  <text class="tick" x="{{ f.x_min }}" y="{{ f.bottom + 18 }}" text-anchor="middle">$0</text>
{% if chart.max_cost %}
  <text class="tick" x="{{ f.right }}" y="{{ f.bottom + 18 }}" text-anchor="end">{{ chart.max_cost | usd_fine }}</text>
{% endif %}
  <text class="tick" x="{{ (f.left + f.right) / 2 }}" y="{{ f.bottom + 40 }}" text-anchor="middle">Projected cost per task</text>
{% if chart.frontier_path %}
  <path class="step" d="{{ chart.frontier_path }}"/>
{% endif %}
{% for p in chart.points %}
{{ whisker(p.x, p.y_high, p.y_low, p.low_n) }}
{% endfor %}
{% for p in chart.points %}
  <circle class="{{ 'frontier' if p.summary.on_frontier else 'dominated' }}" data-model="{{ p.summary.model }}" cx="{{ p.x }}" cy="{{ p.y }}" r="{{ marks.radius }}"><title>{{ p.summary.model }}: {{ p.summary.pass_rate | ci }}, {{ p.summary.projected_cost_per_task | usd_fine }} per task</title></circle>
{% endfor %}
{% for p in chart.points %}
  <text class="label" x="{{ p.label.x }}" y="{{ p.label.y }}" text-anchor="{{ p.label.anchor }}">{{ p.summary.model }}</text>
{% endfor %}
</svg>
{% endmacro %}
<h2>Cost vs accuracy</h2>
{% if charts.overall %}
<p class="note">Each point is a model's pass rate with its 95% interval. The Pareto frontier compares cost with the interval's lower bound; models with no passes are never on it.</p>
<h3>Models overall</h3>
{{ plot(charts.overall, "overall") }}
{% else %}
<p class="note">No graded tasks to plot.</p>
{% endif %}
{% if charts.slices %}
{% if charts.collapse_slices %}
<details>
<summary>Charts by feature and prompt version ({{ charts.slices | length }}), collapsed because every slice has very few graded tasks</summary>
{% else %}
<h3>Charts by feature and prompt version</h3>
{% endif %}
<div class="slices">
{% for chart in charts.slices %}
<section class="card">
<h3>{{ chart.title }}</h3>
{{ plot(chart, "slice") }}
</section>
{% endfor %}
</div>
{% if charts.collapse_slices %}
</details>
{% endif %}
{% endif %}

<h2>By feature and prompt version</h2>
{% if r.summaries %}
<p class="note">Logged model is what production used for that slice, or <code>mixed</code> if it used several.</p>
<div class="scroll"><table>
<thead><tr><th>Feature / version</th><th>Model</th><th>Pass rate</th><th class="num">Errored</th><th class="num">Cost per task</th><th class="num">Cost per success</th><th>Agreement</th><th>Frontier</th><th>Logged model</th></tr></thead>
<tbody>
{% for s in r.summaries %}
<tr><td>{{ group_label(s.feature, s.prompt_version) }}</td><td class="model">{{ s.model }}</td><td class="ci">{{ s.pass_rate | ci }}</td><td class="num">{{ s.errored | tokens }}</td><td class="num">{{ s.projected_cost_per_task | usd_fine }}</td><td class="num">{{ s.cost_per_success | usd_fine }}</td><td class="ci">{{ s.agreement | ci }}</td><td>{{ "yes" if s.on_frontier else "no" }}</td><td class="model">{{ s.logged_model or "n/a" }}</td></tr>
{% endfor %}
</tbody>
</table></div>
{% else %}
<p class="note">No replay outcomes.</p>
{% endif %}

<h2>Failed replays</h2>
{% if failures %}
<p class="note">Showing {{ failures | length }} of {{ failure_count | tokens }}.</p>
<div class="scroll"><table>
<thead><tr><th>Task</th><th>Model</th><th>Reason</th><th>Response excerpt</th></tr></thead>
<tbody>
{% for f in failures %}
<tr><td><code>{{ f.outcome.task_id }}</code></td><td>{{ f.outcome.model }}</td><td>{{ f.reason }}</td><td><code>{{ f.excerpt }}</code></td></tr>
{% endfor %}
</tbody>
</table></div>
{% else %}
<p class="note">No failed replays.</p>
{% endif %}
</main>
</body>
</html>
