<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>tokenize simulation report</title>
<style>
:root {
  --bg: #ffffff; --fg: #1f2328; --muted: #59636e; --border: #d1d9e0;
  --panel: #f6f8fa; --accent: #0969da;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #0d1117; --fg: #e6edf3; --muted: #9198a1; --border: #3d444d;
    --panel: #151b23; --accent: #4493f8;
  }
}
* { box-sizing: border-box; }
body {
  margin: 0; padding: 24px 16px 48px; background: var(--bg); color: var(--fg);
  font: 15px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
}
main { max-width: 1080px; margin: 0 auto; }
h1 { font-size: 1.6rem; margin: 0 0 4px; }
h2 { font-size: 1.25rem; margin: 32px 0 8px; border-bottom: 1px solid var(--border); padding-bottom: 4px; }
h3 { font-size: 1.05rem; margin: 20px 0 6px; }
.meta, .note { color: var(--muted); font-size: 0.9rem; margin: 0 0 8px; }
.tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; }
.tile { background: var(--panel); border: 1px solid var(--border); border-radius: 8px; padding: 12px 14px; }
.tile .label { color: var(--muted); font-size: 0.85rem; }
.tile .value { font-size: 1.2rem; font-weight: 600; font-variant-numeric: tabular-nums; }
.scroll { overflow-x: auto; }
table { border-collapse: collapse; width: 100%; margin: 6px 0 12px; font-size: 0.9rem; }
th, td { border-bottom: 1px solid var(--border); padding: 6px 10px; text-align: left; vertical-align: top; }
th { background: var(--panel); font-weight: 600; }
td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
code { font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: 0.85em; white-space: pre-wrap; word-break: break-word; }
svg { display: block; width: 100%; max-width: 640px; height: auto; }
svg text { fill: var(--fg); font-size: 12px; }
svg .axis { stroke: var(--border); }
svg .bar { stroke: var(--muted); }
svg circle { fill: var(--bg); stroke: var(--accent); stroke-width: 2; }
svg circle.frontier { fill: var(--accent); }
</style>
</head>
<body>
<main>
<h1>tokenize simulation report</h1>
<p class="meta">{% if r.source %}Source: <code>{{ r.source }}</code> · {% endif %}Generated {{ generated }}</p>

<h2>Summary</h2>
<div class="tiles">
  <div class="tile"><div class="label">Simulation spend (Batch API, including judge)</div><div class="value">{{ r.total_sim_cost | usd }}</div></div>
  <div class="tile"><div class="label">Judge model</div><div class="value">{{ r.judge_model or "not used" }}</div></div>
  <div class="tile"><div class="label">Judge vs deterministic agreement</div><div class="value">{{ r.agreement | ci }}</div></div>
</div>

<h2>Models overall</h2>
<p class="note">Pass rates show 95% Wilson intervals over graded tasks. Errored, expired and canceled replays are counted separately. Costs are projected at standard (non-batch) rates.</p>
<div class="scroll"><table>
<thead><tr><th>Model</th><th>Pass rate</th><th class="num">Passes</th><th class="num">Errored</th><th class="num">Cost per task</th><th class="num">Cost per success</th><th>Pareto frontier</th></tr></thead>
<tbody>
{% for s in r.overall %}
<tr><td>{{ s.model }}</td><td>{{ s.pass_rate | ci }}</td><td class="num">{{ s.passes | tokens }}</td><td class="num">{{ s.errored | tokens }}</td><td class="num">{{ s.projected_cost_per_task | usd_fine }}</td><td class="num">{{ s.cost_per_success | usd_fine }}</td><td>{{ "yes" if s.on_frontier else "no" }}</td></tr>
{% endfor %}
</tbody>
</table></div>

<h2>Cost vs accuracy</h2>
{% if charts %}
<p class="note">Each point is a model's pass rate with its 95% interval. Filled points are on the Pareto frontier, which compares cost with the interval's lower bound.</p>
{% else %}
<p class="note">No graded tasks to plot.</p>
{% endif %}
{% for chart in charts %}
<h3>{{ chart.title }}</h3>
<svg viewBox="0 0 640 320" role="img" aria-label="Cost against pass rate for {{ chart.title }}">
  <line class="axis" x1="60" y1="20" x2="60" y2="270"/>
  <line class="axis" x1="60" y1="270" x2="600" y2="270"/>
  <text x="52" y="24" text-anchor="end">100%</text>
  <text x="52" y="149" text-anchor="end">50%</text>
  <text x="52" y="274" text-anchor="end">0%</text>
  <text x="60" y="290">$0</text>
  <text x="600" y="290" text-anchor="end">{{ chart.max_cost | usd_fine }}</text>
  <text x="330" y="310" text-anchor="middle">Projected cost per task</text>
  {% for p in chart.points %}
  <line class="bar" x1="{{ p.x }}" y1="{{ p.y_high }}" x2="{{ p.x }}" y2="{{ p.y_low }}"/>
  <circle class="{{ 'frontier' if p.summary.on_frontier else 'dominated' }}" data-model="{{ p.summary.model }}" cx="{{ p.x }}" cy="{{ p.y }}" r="6"><title>{{ p.summary.model }}: {{ p.summary.pass_rate | ci }}, {{ p.summary.projected_cost_per_task | usd_fine }} per task</title></circle>
  <text x="{{ p.x - 10 if p.x > 330 else p.x + 10 }}" y="{{ p.y + 4 + loop.index0 * 14 }}" text-anchor="{{ 'end' if p.x > 330 else 'start' }}">{{ p.summary.model }}</text>
  {% endfor %}
</svg>
{% endfor %}

<h2>By feature and prompt version</h2>
{% if r.summaries %}
<div class="scroll"><table>
<thead><tr><th>Feature / version</th><th>Model</th><th>Pass rate</th><th class="num">Errored</th><th class="num">Cost per task</th><th class="num">Cost per success</th><th>Agreement</th><th>Frontier</th><th>Baseline</th></tr></thead>
<tbody>
{% for s in r.summaries %}
<tr><td>{{ group_label(s.feature, s.prompt_version) }}</td><td>{{ s.model }}</td><td>{{ s.pass_rate | ci }}</td><td class="num">{{ s.errored | tokens }}</td><td class="num">{{ s.projected_cost_per_task | usd_fine }}</td><td class="num">{{ s.cost_per_success | usd_fine }}</td><td>{{ s.agreement | ci }}</td><td>{{ "yes" if s.on_frontier else "no" }}</td><td>{{ "yes" if s.is_baseline else "no" }}</td></tr>
{% endfor %}
</tbody>
</table></div>
{% else %}
<p class="note">No replay outcomes.</p>
{% endif %}

<h2>Failed replays</h2>
{% if failures %}
<p class="note">Showing {{ failures | length }} of {{ failure_count | tokens }}.</p>
<div class="scroll"><table>
<thead><tr><th>Task</th><th>Model</th><th>Reason</th><th>Response excerpt</th></tr></thead>
<tbody>
{% for f in failures %}
<tr><td><code>{{ f.outcome.task_id }}</code></td><td>{{ f.outcome.model }}</td><td>{{ f.reason }}</td><td><code>{{ f.excerpt }}</code></td></tr>
{% endfor %}
</tbody>
</table></div>
{% else %}
<p class="note">No failed replays.</p>
{% endif %}
</main>
</body>
</html>
